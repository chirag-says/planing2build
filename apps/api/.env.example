# API and worker configuration (p2b.core.config.Settings). Every variable, with its purpose.
# Secret values are never committed; production values live only in the VPS .env (mode 600).

P2B_ENV=local                      # local | test | staging | production
P2B_RELEASE=dev                    # image tag, shown in logs and Sentry

# Database (SECRET). Supabase: transaction pooler for the API, session mode for the worker.
P2B_DATABASE_URL=postgresql+asyncpg://p2b:p2b_local@127.0.0.1:55432/p2b
P2B_MIGRATE_DATABASE_URL=          # app_migrate role; defaults to P2B_DATABASE_URL
P2B_DATABASE_POOLER_MODE=session   # transaction for the API behind Supavisor
P2B_DATABASE_POOL_SIZE=10
P2B_STATEMENT_TIMEOUT_MS=5000

# Hosts; the web app uses the same values.
P2B_HOST_IHB=ihb.localhost
P2B_HOST_PRO=pro.localhost
P2B_HOST_OPS=admin.localhost

# Cookies: true everywhere except LOCAL over plain HTTP (drops the __Host- prefix with it).
P2B_COOKIE_SECURE=false

# Secrets (SECRET). Generate each value per environment; never reuse across environments.
#   peppers: python -c "import secrets; print(secrets.token_urlsafe(32))"
#   key:     python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
P2B_OTP_PEPPER=
P2B_IDENTIFIER_PEPPER=
P2B_ENCRYPTION_KEY=

# Email. resend in staging and production (required in production); smtp = Mailpit locally.
P2B_EMAIL_PROVIDER=smtp
P2B_EMAIL_FROM=Plan2Build <no-reply@plan2build.in>
P2B_RESEND_API_KEY=                # SECRET
P2B_SMTP_HOST=localhost
P2B_SMTP_PORT=1025

# Object storage, S3 API (ADR-006). R2 in staging/production (bucket CORS must allow PUT from the
# homeowner host only); SeaweedFS locally (infra/local/compose.yml). memory = tests only.
P2B_STORAGE_PROVIDER=s3
P2B_STORAGE_ENDPOINT_INTERNAL=http://localhost:9000   # what the API and worker call
P2B_STORAGE_ENDPOINT_PUBLIC=http://localhost:9000     # what browsers reach (presigned URLs)
P2B_STORAGE_REGION=auto
P2B_STORAGE_ACCESS_KEY=
P2B_STORAGE_SECRET_KEY=
P2B_STORAGE_BUCKET_PRIVATE=p2b-local-private

# Malware scanning (INTEGRATION section 7). clamav is required in production; accept_all = tests only.
P2B_SCANNER_PROVIDER=clamav
P2B_CLAMAV_HOST=localhost
P2B_CLAMAV_PORT=3310

# Locality from the map pin (R-3). The public Nominatim service allows 1 request/s and needs an
# identifying User-Agent; production use needs its own instance or a provider (blocker AQ-19).
P2B_GEOCODER_PROVIDER=nominatim                      # nominatim | none
P2B_NOMINATIM_URL=https://nominatim.openstreetmap.org
P2B_NOMINATIM_USER_AGENT=Plan2Build/0.1 (contact: tech@plan2build.in)

# Operations notifications (ruling 2.8): new submissions, flags, enquiries. Unset = skipped and
# logged. Set per environment once the operations mailbox exists; never a guessed address.
P2B_OPS_NOTIFICATION_EMAIL=

P2B_LOG_LEVEL=INFO
P2B_SENTRY_DSN=                    # SECRET-ish; empty disables Sentry

# Worker
P2B_WORKER_QUEUES=                 # JSON list, e.g. ["render","files"]; empty = every queue
P2B_WORKER_CONCURRENCY=8

# Open point F-09: show each specification line's criteria before the package is active.
# A setting, not a rule; false follows ruling 2.6 until Chirag decides.
P2B_SPEC_CRITERIA_BEFORE_PACKAGE=false

# AI design concepts (Slice 3.1). Unset means `none`: generation off until a provider is chosen
# (AQ-15). `demo` draws placeholder images locally and is refused in production. Limits are development
# defaults, not commercial rules: change them here, not in code.
P2B_AI_IMAGE_PROVIDER=demo
P2B_AI_FREE_GENERATIONS_PER_PROJECT=3
P2B_AI_MAX_PROJECTS_PER_ACCOUNT_PER_DAY=3
P2B_AI_MAX_GENERATIONS_PER_ACCOUNT_PER_DAY=10
P2B_AI_PROVIDER_TIMEOUT_SECONDS=90
P2B_AI_PROVIDER_ATTEMPTS=2
# Concept floor plans (PD-28, ADR-025). LOCAL ONLY values: production refuses draft and synthetic
# rulesets and keeps the feature off until AD-05 and AD-06 (CP1-05, CP1-06).
P2B_HOUSEPLANS_ENABLED=true
P2B_HOUSEPLANS_ALLOW_DRAFT_RULESET=true
P2B_HOUSEPLANS_ALLOW_SYNTHETIC_RULESET=true
P2B_HOUSEPLANS_SOLVE_TIMEOUT_SECONDS=30

# Billing (Slice 3.3; SLICE3_3_READINESS). `none` keeps buying off; `fake` is the local and test
# gateway (refused in staging and production); `razorpay` takes money (test keys in staging, live
# `rzp_live_` keys in production only). Only the key id reaches the browser. Prices, instalments
# and tax are published configuration versions (ADMIN), never variables or code.
P2B_PAYMENT_PROVIDER=none
P2B_PAYMENT_KEY_ID=
P2B_PAYMENT_KEY_SECRET=
P2B_PAYMENT_WEBHOOK_SECRET=
P2B_RAZORPAY_API_URL=https://api.razorpay.com/v1
P2B_PAYMENT_TIMEOUT_SECONDS=15
P2B_BILLING_ATTEMPT_CHECK_MINUTES=30   # an attempt with no outcome is checked with the provider after this
# P2B_BILLING_UNPAID_ORDER_HOURS=      # O-12 open: unset keeps unpaid orders open until the buyer cancels
P2B_INVOICE_FONT_PATH=                 # a TrueType font for invoice PDFs; required in production
